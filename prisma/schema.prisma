generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudyNode {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  type          String
  nodeKind          String?
  curriculumKey     String? @unique
  curriculumVersion String?
  curriculumTitle   String?
  userEditedAt      DateTime?
  overview      String?         @db.Text
  details       String?         @db.LongText
  accent        String?
  sortOrder     Int             @default(0)
  parentId      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  parent        StudyNode?      @relation("StudyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      StudyNode[]     @relation("StudyTree")
  studyLogs     StudyLog[]
  testRecords   TestRecord[]
  topicProgress TopicProgress?
  agentTasks    AgentTask[]
  pyqQuestions  PyqQuestion[]
}

model TopicProgress {
  id             String     @id @default(cuid())
  studyNodeId    String     @unique
  checked        Boolean    @default(false)
  checkedAt      DateTime?
  revisionCount  Int        @default(0)
  lastRevisedAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  studyNode      StudyNode  @relation(fields: [studyNodeId], references: [id], onDelete: Cascade)
}

model StudyLog {
  id           String     @id @default(cuid())
  studyNodeId  String?
  title        String
  logDate      DateTime
  hours        Float
  topicCount   Int        @default(0)
  completion   Int        @default(0)
  focusScore   Int?
  notes        String?    @db.Text
  studyNode    StudyNode? @relation(fields: [studyNodeId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model DailyLog {
  id              String   @id @default(cuid())
  logDate         DateTime @unique
  primaryFocus    String
  totalHours      Float
  wins            String?  @db.Text
  blockers        String?  @db.Text
  tomorrowPlan    String?  @db.Text
  disciplineScore Int      @default(0)
  completion      Int      @default(0)
  questionsSolved Int      @default(0)
  topicsStudied   Int      @default(0)
  subjectsCovered String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ScreenTimeLog {
  id           String   @id @default(cuid())
  logDate      DateTime @unique
  instagram    Float    @default(0)
  whatsapp     Float    @default(0)
  youtube      Float    @default(0)
  youtubeStudy Float    @default(0)
  facebook     Float    @default(0)
  netflix      Float    @default(0)
  hotstar      Float    @default(0)
  mxPlayer     Float    @default(0)
  google       Float    @default(0)
  other        Float    @default(0)
  note         String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MoodEntry {
  id          String   @id @default(cuid())
  moodDate    DateTime @unique
  label       String
  energy      Int
  focus       Int
  stress      Int
  confidence  Int
  consistency Int
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TestRecord {
  id                 String     @id @default(cuid())
  studyNodeId        String?
  title              String
  examStage          String
  testType           String
  paperCode          String?
  paperName          String?
  optionalSubject    String?
  testDate           DateTime
  totalQuestions     Int        @default(0)
  totalMarks         Float
  score              Float
  negativeMarks      Float?
  cutoffTarget       Float?
  correctQuestions   Int?
  incorrectQuestions Int?
  attemptedQuestions Int?
  percentile         Float?
  timeMinutes        Int?
  notes              String?    @db.Text
  studyNode          StudyNode? @relation(fields: [studyNodeId], references: [id], onDelete: SetNull)
  questionLogs       TestQuestionLog[]
  analysisReports    TestAnalysisReport[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model TestQuestionLog {
  id                  String     @id @default(cuid())
  testRecordId        String
  questionNumber      Int
  questionType        String     @default("OBJECTIVE")
  questionSummary     String     @db.Text
  selectedAnswer      String?    @db.Text
  correctAnswer       String?    @db.Text
  correctExplanation  String?    @db.Text
  mainsApproach       String?    @db.Text
  mainsExamples       String?    @db.Text
  valueAddedPoints    String?    @db.Text
  subject             String?
  topic               String?
  sourceType          String     @default("PRACTICE_TEST")
  outcome             String     @default("SKIPPED")
  marksAwarded        Float?
  maxMarks            Float?
  wordLimit           Int?
  wordCount           Int?
  structureScore      Int?
  contentScore        Int?
  presentationScore   Int?
  studiedTopic        Boolean    @default(false)
  resourceCovered     String     @default("UNKNOWN")
  currentAffairsLinked Boolean   @default(false)
  errorType           String?
  difficulty          String     @default("MEDIUM")
  confidence          Int?
  timeSpentSeconds    Int?
  mistakeReason       String?    @db.Text
  actionFix           String?    @db.Text
  notes               String?    @db.Text
  testRecord          TestRecord @relation(fields: [testRecordId], references: [id], onDelete: Cascade)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([testRecordId, questionNumber])
  @@index([testRecordId, outcome])
  @@index([subject, topic])
}

model TestAnalysisReport {
  id              String      @id @default(cuid())
  scope           String
  testRecordId    String?
  title           String
  reportText      String      @db.LongText
  highlightsJson  String?     @db.LongText
  weakAreasJson   String?     @db.LongText
  recommendationsJson String?  @db.LongText
  model           String?
  createdAt       DateTime    @default(now())
  testRecord      TestRecord? @relation(fields: [testRecordId], references: [id], onDelete: Cascade)

  @@index([scope, createdAt])
  @@index([testRecordId, createdAt])
}

model EssaySubmission {
  id          String   @id @default(cuid())
  title       String
  prompt      String   @db.Text
  content     String   @db.LongText
  feedback    String?  @db.LongText
  score       Float?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiConversation {
  id        String      @id @default(cuid())
  title     String
  persona   String      @default("guru")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String         @db.LongText
  attachmentText String?        @db.LongText
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    AiAttachment[]
}

model AiAttachment {
  id            String    @id @default(cuid())
  messageId     String
  kind          String
  name          String
  mimeType      String
  sizeBytes     Int?
  extractedText String?   @db.LongText
  createdAt     DateTime  @default(now())
  message       AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AiMemoryProfile {
  id          String   @id @default(cuid())
  persona     String   @unique
  summaryText String   @db.LongText
  summaryJson String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppNotification {
  id             String   @id @default(cuid())
  title          String
  body           String   @db.Text
  tone           String   @default("focus")
  senderLabel    String
  senderClientId String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([senderClientId])
}

model PushSubscription {
  id             String   @id @default(cuid())
  endpoint       String   @unique @db.VarChar(768)
  p256dh         String   @db.VarChar(255)
  auth           String   @db.VarChar(255)
  senderClientId String?  @db.VarChar(80)
  userAgent      String?  @db.VarChar(320)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([senderClientId])
}

model AgentMission {
  id                  String      @id @default(cuid())
  title               String
  goal                String?     @db.Text
  mode                String      @default("MISSION_CONTROL")
  status              String      @default("READY")
  summary             String?     @db.LongText
  executionWindow     String?
  urgency             String?
  plannerNotes        String?     @db.LongText
  risksJson           String?     @db.LongText
  followUpsJson       String?     @db.LongText
  whyNowJson          String?     @db.LongText
  todayPlanJson       String?     @db.LongText
  dailyLogDraftJson   String?     @db.LongText
  contextSnapshotJson String?     @db.LongText
  model               String?
  launchedAt          DateTime    @default(now())
  lastActivatedAt     DateTime?
  appliedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tasks               AgentTask[]
}

model AgentTask {
  id                String        @id @default(cuid())
  missionId         String
  linkedStudyNodeId String?
  title             String
  detail            String?       @db.Text
  rationale         String?       @db.Text
  taskType          String        @default("TASK")
  status            String        @default("TODO")
  priority          String        @default("MEDIUM")
  energyBand        String?
  source            String        @default("AI")
  checklistJson     String?       @db.LongText
  dueLabel          String?
  estimatedMinutes  Int?
  scheduledFor      DateTime?
  orderIndex        Int           @default(0)
  completionNotes   String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  mission           AgentMission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  linkedStudyNode   StudyNode?    @relation(fields: [linkedStudyNodeId], references: [id], onDelete: SetNull)

  @@index([missionId, status, orderIndex])
}

model AgentMemory {
  id             String    @id @default(cuid())
  kind           String    @default("INSIGHT")
  content        String    @db.Text
  sourceNote     String?   @db.VarChar(255)
  importance     Int       @default(3)
  status         String    @default("ACTIVE")
  lastRecalledAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, kind, importance])
  @@index([updatedAt])
}

model DayPlan {
  id                String    @id @default(cuid())
  planDate          DateTime  @unique
  briefingTitle     String    @db.VarChar(120)
  briefingText      String    @db.Text
  proposedTasksJson String    @db.LongText
  contextJson       String?   @db.LongText
  status            String    @default("PENDING")
  approvedTaskCount Int       @default(0)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, planDate])
}

model CurrentAffairsDigest {
  id            String   @id @default(cuid())
  digestDate     DateTime @unique
  summaryText    String   @db.LongText
  itemsJson      String   @db.LongText
  quizJson       String?  @db.LongText
  editorialsJson String?  @db.LongText
  sourcesJson    String?  @db.Text
  model         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([digestDate])
}

model CaQuizAttempt {
  id            String   @id @default(cuid())
  digestDate    DateTime
  questionIndex Int
  question      String   @db.Text
  optionsJson   String?  @db.Text
  selectedIndex Int
  correctIndex  Int
  isCorrect     Boolean
  explanation   String?  @db.Text
  syllabusTag   String?  @db.VarChar(120)
  createdAt     DateTime @default(now())

  @@unique([digestDate, questionIndex])
  @@index([digestDate])
  @@index([createdAt])
}

model WeeklyReview {
  id                  String    @id @default(cuid())
  weekStart           DateTime  @unique
  reportText          String    @db.LongText
  statsJson           String    @db.LongText
  moodCorrelationJson String?   @db.LongText
  integrityJson       String?   @db.LongText
  quizJson            String?   @db.LongText
  model               String?
  seenAt              DateTime?
  notifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([weekStart])
}

model MonthlyReview {
  id            String    @id @default(cuid())
  monthStart    DateTime  @unique
  reportText    String    @db.LongText
  statsJson     String    @db.LongText
  integrityJson String?   @db.LongText
  quizJson      String?   @db.LongText
  model         String?
  seenAt        DateTime?
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([monthStart])
}

model PyqQuestion {
  id            String     @id @default(cuid())
  year          Int
  examStage     String     @default("PRELIMS")
  paper         String?    @db.VarChar(80)
  subject       String?    @db.VarChar(120)
  topic         String?    @db.VarChar(255)
  question      String     @db.Text
  optionsJson   String?    @db.Text
  correctAnswer String?    @db.Text
  explanation   String?    @db.Text
  studyNodeId   String?
  askedCount    Int        @default(0)
  lastAskedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  studyNode     StudyNode? @relation(fields: [studyNodeId], references: [id], onDelete: SetNull)

  @@index([subject, topic])
  @@index([year, examStage])
}

model CrossExamEntry {
  id             String    @id @default(cuid())
  question       String    @db.Text
  expectedPoints String?   @db.Text
  topicLabel     String?   @db.VarChar(255)
  subjectLabel   String?   @db.VarChar(120)
  userAnswer     String?   @db.Text
  verdict        String    @default("PENDING")
  score          Int?
  feedback       String?   @db.Text
  followUpAt     DateTime?
  askedAt        DateTime  @default(now())
  answeredAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([verdict, followUpAt])
  @@index([subjectLabel, topicLabel])
  @@index([askedAt])
}

// ── AI-ML Vault ───────────────────────────────────────────────────────────
// A private workspace behind its own unlock. The roadmap itself is static
// data (data/ai-roadmap-2026.json); these tables hold only progress and logs,
// keyed by stable item keys such as "s8.c3" or "s8.gate.t1".

model VaultAttempt {
  id          String    @id @default(cuid())
  keyHash     String    @unique @db.VarChar(64)
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("vault_attempts")
}

model VaultEvent {
  id        String   @id @default(cuid())
  kind      String   @db.VarChar(32)
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("vault_events")
}

model AiVaultConfig {
  id               String   @id @default("main")
  startDate        DateTime
  weeklyHourTarget Float    @default(20)
  updatedAt        DateTime @updatedAt

  @@map("ai_vault_config")
}

model AiProgress {
  id          String    @id @default(cuid())
  itemKey     String    @unique @db.VarChar(64)
  status      String    @default("todo") @db.VarChar(16)
  evidenceUrl String?   @db.VarChar(512)
  note        String?   @db.Text
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("ai_progress")
}

model AiStudyLog {
  id             String   @id @default(cuid())
  logDate        DateTime @db.Date
  stage          Int
  readingMin     Int      @default(0)
  implementMin   Int      @default(0)
  adversarialMin Int      @default(0)
  reviewMin      Int      @default(0)
  focus          String?  @db.VarChar(200)
  topicKey       String?  @db.VarChar(64)
  trackId        String?  @db.VarChar(32)
  note           String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([logDate])
  @@map("ai_study_logs")
}

model AiArtifact {
  id         String   @id @default(cuid())
  stage      Int
  title      String   @db.VarChar(200)
  repoUrl    String?  @db.VarChar(512)
  tag        String?  @db.VarChar(80)
  p50Ms      Float?
  p95Ms      Float?
  peakRssMb  Float?
  costPerReq Float?
  adrUrl     String?  @db.VarChar(512)
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([stage, createdAt])
  @@map("ai_artifacts")
}

model AiWeeklyReview {
  id         String   @id @default(cuid())
  weekStart  DateTime @unique @db.Date
  tag        String?  @db.VarChar(80)
  wins       String?  @db.Text
  risks      String?  @db.Text
  rubricJson Json?
  createdAt  DateTime @default(now())

  @@map("ai_weekly_reviews")
}

// Your own subjects beyond the manual (e.g. DSA, maths, MLOps), each with topics.
model AiTrack {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(120)
  hue           Int      @default(190)
  weeklyMinutes Int?
  note          String?  @db.Text
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("ai_tracks")
}

// Extra topics: on one of your tracks, or added to a roadmap stage.
model AiTopic {
  id          String    @id @default(cuid())
  trackId     String?   @db.VarChar(32)
  stage       Int?
  name        String    @db.VarChar(200)
  status      String    @default("todo") @db.VarChar(16)
  note        String?   @db.Text
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([trackId])
  @@index([stage])
  @@map("ai_topics")
}

// Quizzes, mock interviews, coding contests, certifications — any scored check.
model AiAssessment {
  id        String   @id @default(cuid())
  takenOn   DateTime @db.Date
  title     String   @db.VarChar(200)
  kind      String   @default("quiz") @db.VarChar(16)
  stage     Int?
  trackId   String?  @db.VarChar(32)
  topicKey  String?  @db.VarChar(64)
  score     Float
  maxScore  Float
  minutes   Int?
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([takenOn])
  @@map("ai_assessments")
}

model AiAnalysis {
  id        String   @id @default(cuid())
  model     String?  @db.VarChar(80)
  text      String   @db.LongText
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ai_analyses")
}

// ── Gate: salted scrypt hashes for the dashboard-switch passwords (never plain text) ──
model GateSecret {
  id        String   @id @db.VarChar(32)
  hash      String   @db.VarChar(255)
  updatedAt DateTime @updatedAt

  @@map("gate_secrets")
}

// ── Personal hub, shared by the UPSC and NEET sites. owner: adarsh | misti | joint ──
model HubGoal {
  id           String    @id @default(cuid())
  owner        String    @db.VarChar(8)
  title        String    @db.VarChar(200)
  area         String    @default("life") @db.VarChar(24)
  priority     Int       @default(2)
  deadline     DateTime? @db.Date
  status       String    @default("active") @db.VarChar(12)
  progress     Int       @default(0)
  targetAmount Float?
  fundId       String?   @db.VarChar(32)
  note         String?   @db.Text
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([owner])
  @@map("hub_goals")
}

model HubTask {
  id        String    @id @default(cuid())
  owner     String    @db.VarChar(8)
  title     String    @db.VarChar(200)
  priority  Int       @default(2)
  due       DateTime? @db.Date
  goalId    String?   @db.VarChar(32)
  status    String    @default("todo") @db.VarChar(8)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([owner, status])
  @@map("hub_tasks")
}

model HubTxn {
  id        String   @id @default(cuid())
  owner     String   @db.VarChar(8)
  kind      String   @db.VarChar(8)
  amount    Float
  category  String   @db.VarChar(32)
  method    String?  @db.VarChar(16)
  txnDate   DateTime @db.Date
  note      String?  @db.VarChar(300)
  recurring Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([owner, txnDate])
  @@map("hub_txns")
}

model HubBudget {
  id       String @id @default(cuid())
  owner    String @db.VarChar(8)
  category String @db.VarChar(32)
  monthly  Float

  @@unique([owner, category])
  @@map("hub_budgets")
}

model HubFund {
  id         String    @id @default(cuid())
  owner      String    @db.VarChar(8)
  name       String    @db.VarChar(120)
  kind       String    @default("goal") @db.VarChar(16)
  target     Float
  targetDate DateTime? @db.Date
  note       String?   @db.Text
  archived   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@map("hub_funds")
}

model HubFundEntry {
  id        String   @id @default(cuid())
  fundId    String   @db.VarChar(32)
  owner     String   @db.VarChar(8)
  amount    Float
  entryDate DateTime @db.Date
  note      String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  @@index([fundId])
  @@map("hub_fund_entries")
}

model HubAccount {
  id        String   @id @default(cuid())
  owner     String   @db.VarChar(8)
  name      String   @db.VarChar(120)
  kind      String   @db.VarChar(12)
  balance   Float
  updatedAt DateTime @updatedAt

  @@map("hub_accounts")
}

model HubEvent {
  id        String   @id @default(cuid())
  owner     String   @db.VarChar(8)
  title     String   @db.VarChar(200)
  kind      String   @default("other") @db.VarChar(16)
  eventDate DateTime @db.Date
  budget    Float?
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([eventDate])
  @@map("hub_events")
}

model HubPlanItem {
  id        String    @id @default(cuid())
  plan      String    @default("wedding") @db.VarChar(16)
  owner     String    @db.VarChar(8)
  title     String    @db.VarChar(200)
  category  String    @default("other") @db.VarChar(24)
  estimate  Float?
  paid      Float     @default(0)
  due       DateTime? @db.Date
  status    String    @default("todo") @db.VarChar(8)
  note      String?   @db.Text
  createdAt DateTime  @default(now())

  @@map("hub_plan_items")
}

model HubSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("hub_settings")
}

model HubAnalysis {
  id        String   @id @default(cuid())
  actor     String   @db.VarChar(8)
  model     String?  @db.VarChar(80)
  text      String   @db.LongText
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("hub_analyses")
}
